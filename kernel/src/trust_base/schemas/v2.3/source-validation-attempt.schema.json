{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trellis://schemas/source-validation-attempt/v1",
  "title": "Raw non-authoritative source-validation attempt evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attempt_id",
    "role",
    "target_id",
    "target_statement_sha256",
    "validation_contract_id",
    "validation_contract_sha256",
    "source_claim_lineage_id",
    "source_claim_lineage_sha256",
    "full_tuple_sha256",
    "harness_cohort_sha256",
    "source_tree_sha256",
    "source_scope",
    "toolchain_build_basis_sha256",
    "public_entry_point",
    "entry_point_type_sha256",
    "runner_binary_sha256",
    "environment_contract_sha256",
    "actual_environment_sha256",
    "command_sha256",
    "concretization_schema_sha256",
    "erasure_relation_sha256",
    "raw_observation_schema_sha256",
    "precondition_results",
    "execution",
    "execution_receipt",
    "raw_artifact_manifest_sha256",
    "attempt_sha256"
  ],
  "properties": {
    "schema": { "const": "trellis-source-validation-attempt/v1" },
    "attempt_id": { "$ref": "#/$defs/id" },
    "role": { "enum": ["exact_witness", "positive_control", "corroborating_proxy"] },
    "target_id": { "$ref": "#/$defs/id" },
    "target_statement_sha256": { "$ref": "#/$defs/hash" },
    "validation_contract_id": { "$ref": "#/$defs/id" },
    "validation_contract_sha256": { "$ref": "#/$defs/hash" },
    "source_claim_lineage_id": { "$ref": "#/$defs/id" },
    "source_claim_lineage_sha256": { "$ref": "#/$defs/hash" },
    "full_tuple_sha256": { "$ref": "#/$defs/hash" },
    "harness_cohort_sha256": { "$ref": "#/$defs/hash" },
    "source_tree_sha256": { "$ref": "#/$defs/hash" },
    "source_scope": { "enum": ["adapted_source", "upstream_source_equivalent"] },
    "toolchain_build_basis_sha256": { "$ref": "#/$defs/hash" },
    "public_entry_point": { "$ref": "#/$defs/id" },
    "entry_point_type_sha256": { "$ref": "#/$defs/hash" },
    "runner_binary_sha256": { "$ref": "#/$defs/hash" },
    "environment_contract_sha256": { "$ref": "#/$defs/hash" },
    "actual_environment_sha256": { "$ref": "#/$defs/hash" },
    "command_sha256": { "$ref": "#/$defs/hash" },
    "concretization_schema_sha256": { "$ref": "#/$defs/hash" },
    "erasure_relation_sha256": { "$ref": "#/$defs/hash" },
    "raw_observation_schema_sha256": { "$ref": "#/$defs/hash" },
    "precondition_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/preconditionResult" }
    },
    "formal_witness_certificate_sha256": { "$ref": "#/$defs/hash" },
    "witness_term_sha256": { "$ref": "#/$defs/hash" },
    "formal_predicate_sha256": { "$ref": "#/$defs/hash" },
    "encoded_input_or_descriptor_sha256": { "$ref": "#/$defs/hash" },
    "concretization_receipt_sha256": { "$ref": "#/$defs/hash" },
    "erasure_receipt_sha256": { "$ref": "#/$defs/hash" },
    "observation_oracle_sha256": { "$ref": "#/$defs/hash" },
    "supporting_exact_case_id": { "$ref": "#/$defs/id" },
    "control_input_sha256": { "$ref": "#/$defs/hash" },
    "control_expectation_schema_sha256": { "$ref": "#/$defs/hash" },
    "proxy_input_sha256": { "$ref": "#/$defs/hash" },
    "proxy_relation_sha256": { "$ref": "#/$defs/hash" },
    "independent_basis_id": { "$ref": "#/$defs/id" },
    "independent_basis_sha256": { "$ref": "#/$defs/hash" },
    "forbid_unsafe_compilation_receipt_sha256": { "$ref": "#/$defs/hash" },
    "safe_construction_receipt_sha256": { "$ref": "#/$defs/hash" },
    "execution": { "$ref": "#/$defs/execution" },
    "execution_receipt": { "type": "object" },
    "raw_artifact_manifest_sha256": { "$ref": "#/$defs/hash" },
    "attempt_sha256": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": { "properties": { "role": { "const": "exact_witness" } }, "required": ["role"] },
      "then": {
        "required": [
          "formal_witness_certificate_sha256",
          "witness_term_sha256",
          "formal_predicate_sha256",
          "encoded_input_or_descriptor_sha256",
          "concretization_receipt_sha256",
          "erasure_receipt_sha256",
          "observation_oracle_sha256",
          "forbid_unsafe_compilation_receipt_sha256",
          "safe_construction_receipt_sha256"
        ]
      }
    },
    {
      "if": { "properties": { "role": { "const": "positive_control" } }, "required": ["role"] },
      "then": {
        "required": [
          "supporting_exact_case_id",
          "control_input_sha256",
          "control_expectation_schema_sha256"
        ]
      }
    },
    {
      "if": { "properties": { "role": { "const": "corroborating_proxy" } }, "required": ["role"] },
      "then": {
        "required": ["supporting_exact_case_id", "proxy_input_sha256", "proxy_relation_sha256"]
      }
    },
    {
      "if": {
        "required": ["independent_basis_id"]
      },
      "then": { "required": ["independent_basis_sha256"] }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "preconditionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precondition_id",
        "normalized_statement_sha256",
        "checker_sha256",
        "result",
        "checker_receipt_sha256"
      ],
      "properties": {
        "precondition_id": { "$ref": "#/$defs/id" },
        "normalized_statement_sha256": { "$ref": "#/$defs/hash" },
        "checker_sha256": { "$ref": "#/$defs/hash" },
        "result": { "enum": ["true", "false", "unknown"] },
        "checker_receipt_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_performed",
        "attempted_allocation",
        "source_call_started",
        "source_call_completed",
        "termination_kind",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "preflight_performed": { "type": "boolean" },
        "attempted_allocation": { "type": "boolean" },
        "source_call_started": { "type": "boolean" },
        "source_call_completed": { "type": "boolean" },
        "termination_kind": {
          "enum": [
            "normal_return",
            "target_relevant_panic",
            "harness_failure",
            "signal",
            "timeout",
            "not_started"
          ]
        },
        "serialized_source_observation_sha256": { "$ref": "#/$defs/hash" },
        "stdout_sha256": { "$ref": "#/$defs/hash" },
        "stderr_sha256": { "$ref": "#/$defs/hash" },
        "exit_status": {
          "type": ["integer", "null"],
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "signal": { "type": ["integer", "null"], "minimum": 0, "maximum": 2147483647 },
        "elapsed_milliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    }
  }
}
