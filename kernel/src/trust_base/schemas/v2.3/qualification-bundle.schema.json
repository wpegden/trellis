{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trellis://schemas/qualification-bundle/v1",
  "title": "Replay-status-independent checked qualification bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_id",
    "target_id",
    "target_statement_sha256",
    "source_claim_lineage_id",
    "source_claim_lineage_sha256",
    "validation_contract_id",
    "validation_contract_sha256",
    "profile_id",
    "profile_definition_sha256",
    "unrestricted_verdict",
    "formal_refutation_sha256",
    "source_validation_history_summary_sha256",
    "source_validation_history_event_hash",
    "independent_basis_id",
    "independent_basis_sha256",
    "witness_resource_demand_sha256",
    "source_witness_admissibility_sha256",
    "condition_sha256",
    "checked_witness_exclusion_sha256",
    "checked_condition_nonempty_sha256",
    "conditionalization_schema_id",
    "generated_conditional_statement_sha256",
    "conditional_theorem_candidate_sha256",
    "conditional_proof_receipt_sha256",
    "checked_conditional_proof_sha256",
    "checker_and_axiom_closure_sha256",
    "checker_execution_receipt",
    "checker_execution_receipt_sha256",
    "journal_predecessor_sha256",
    "bundle_sha256"
  ],
  "properties": {
    "schema": { "const": "trellis-qualification-bundle/v1" },
    "bundle_id": { "$ref": "#/$defs/id" },
    "target_id": { "$ref": "#/$defs/id" },
    "target_statement_sha256": { "$ref": "#/$defs/hash" },
    "source_claim_lineage_id": { "$ref": "#/$defs/id" },
    "source_claim_lineage_sha256": { "$ref": "#/$defs/hash" },
    "validation_contract_id": { "$ref": "#/$defs/id" },
    "validation_contract_sha256": { "$ref": "#/$defs/hash" },
    "profile_id": { "$ref": "#/$defs/id" },
    "profile_definition_sha256": { "$ref": "#/$defs/hash" },
    "unrestricted_verdict": { "const": "refuted_in_extracted_model" },
    "formal_refutation_sha256": { "$ref": "#/$defs/hash" },
    "source_validation_history_summary_sha256": { "$ref": "#/$defs/hash" },
    "source_validation_history_event_hash": { "$ref": "#/$defs/hash" },
    "independent_basis_id": { "$ref": "#/$defs/id" },
    "independent_basis_sha256": { "$ref": "#/$defs/hash" },
    "witness_resource_demand_sha256": { "$ref": "#/$defs/hash" },
    "source_witness_admissibility_sha256": { "$ref": "#/$defs/hash" },
    "condition_sha256": { "$ref": "#/$defs/hash" },
    "checked_witness_exclusion_sha256": { "$ref": "#/$defs/hash" },
    "checked_condition_nonempty_sha256": { "$ref": "#/$defs/hash" },
    "conditionalization_schema_id": { "$ref": "#/$defs/id" },
    "generated_conditional_statement_sha256": { "$ref": "#/$defs/hash" },
    "conditional_theorem_candidate_sha256": { "$ref": "#/$defs/hash" },
    "conditional_proof_receipt_sha256": { "$ref": "#/$defs/hash" },
    "checked_conditional_proof_sha256": { "$ref": "#/$defs/hash" },
    "checker_and_axiom_closure_sha256": { "$ref": "#/$defs/hash" },
    "checker_execution_receipt": { "type": "object" },
    "checker_execution_receipt_sha256": { "$ref": "#/$defs/hash" },
    "journal_predecessor_sha256": { "$ref": "#/$defs/hash" },
    "bundle_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
