{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trellis://schemas/journal-event-bundle/v1",
  "title": "Self-contained journal event, payload wrapper, and subject bytes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event", "payload", "subject_encoding", "bundle_sha256"],
  "properties": {
    "schema": { "const": "trellis-journal-event-bundle/v1" },
    "event": { "$ref": "trellis://schemas/journal-event/v1" },
    "payload": { "$ref": "trellis://schemas/journal-event-payload/v1" },
    "actor_authentication_receipt": {
      "$ref": "trellis://schemas/actor-authentication-receipt/v1"
    },
    "subject_encoding": { "enum": ["canonical_json", "raw_base64"] },
    "subject_json": { "type": "object" },
    "subject_base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "bundle_sha256": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": { "properties": { "subject_encoding": { "const": "canonical_json" } } },
      "then": {
        "required": ["subject_json"],
        "not": { "required": ["subject_base64"] }
      },
      "else": {
        "required": ["subject_base64"],
        "not": { "required": ["subject_json"] }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "properties": {
              "actor_role": { "enum": ["reviewer", "audit_authority"] }
            }
          }
        }
      },
      "then": { "required": ["actor_authentication_receipt"] },
      "else": { "not": { "required": ["actor_authentication_receipt"] } }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
